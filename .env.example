# Скопируйте этот файл в Railway -> Variables (как переменные окружения сервиса)

# Базовая аутентификация веб-интерфейса n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Ключ шифрования для credentials (сгенерируйте случайную строку и сохраните её — без неё нельзя расшифровать сохранённые credentials)
N8N_ENCRYPTION_KEY=change-me

# Публичный адрес сервиса (домен, который выдаст Railway, например: my-app.up.railway.app)
N8N_HOST=your-app.up.railway.app
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-app.up.railway.app/

# Часовой пояс
GENERIC_TIMEZONE=Europe/Berlin
